<Project>
  <Import Project="Sdk.props" Sdk="Smdn.MSBuild.ProjectAssets.Library" />

  <PropertyGroup Condition=" '$(IsTestProject)' == 'true' ">
    <TestAssemblyRootDirectory>$(MSBuildThisFileDirectory)\test-assm</TestAssemblyRootDirectory>
    <!-- default target frameworks for test projects -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition=" '$(IsTestProject)' == 'true' ">
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Smdn.MSBuild.DefineConstants.NETSdkApi"
      Version="[1.8.5]"
      PrivateAssets="all"
      IncludeAssets="build"
    />
  </ItemGroup>
</Project>
