<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(TargetFrameworks);net48;net47</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- do not use 'enable' or 'annotations': affects the behavior of the test cases -->
    <Nullable>warnings</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\Smdn.Reflection.ReverseGenerating.TestCases\Common\Smdn.Reflection.ReverseGenerating.TestCases.Common.csproj"
    />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\Smdn.Reflection.ReverseGenerating.TestCases\RuntimeAsync\Smdn.Reflection.ReverseGenerating.TestCases.RuntimeAsync.csproj"
      Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\**\*.cs" />
    <PackageReference
      Include="System.Runtime.InteropServices.RuntimeInformation"
      Version="4.3.0"
      Condition = "(
        $(TargetFramework.StartsWith('net45')) or
        $(TargetFramework.StartsWith('net46')) or
        $(TargetFramework.StartsWith('net47'))
      )"
    />
  </ItemGroup>
</Project>
